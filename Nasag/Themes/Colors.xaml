<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modern Slate & Navy palette -->
    <Color x:Key="NavySidebarColor">#0F172A</Color>
    <Color x:Key="NavyDeepColor">#1E293B</Color>
    <Color x:Key="NavyHoverColor">#1E3A5F</Color>

    <!-- Modern Vibrant Teal Primary -->
    <Color x:Key="TealPrimaryColor">#0D9488</Color>
    <Color x:Key="TealHoverColor">#0F766E</Color>
    <Color x:Key="TealPressedColor">#115E59</Color>
    <Color x:Key="TealSoftColor">#F0FDFA</Color>

    <!-- Surfaces & Borders -->
    <Color x:Key="BackgroundColor">#F8FAFC</Color>
    <Color x:Key="CardSurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>

    <!-- Typography (Slate Scale for enhanced legibility) -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextOnNavyColor">#FFFFFF</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessSoftColor">#ECFDF5</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSoftColor">#FFFBEB</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerSoftColor">#FEF2F2</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="InfoSoftColor">#EFF6FF</Color>

    <SolidColorBrush x:Key="NavySidebarBrush" Color="{StaticResource NavySidebarColor}" />
    <SolidColorBrush x:Key="NavyDeepBrush" Color="{StaticResource NavyDeepColor}" />
    <SolidColorBrush x:Key="NavyHoverBrush" Color="{StaticResource NavyHoverColor}" />

    <SolidColorBrush x:Key="TealPrimaryBrush" Color="{StaticResource TealPrimaryColor}" />
    <SolidColorBrush x:Key="TealHoverBrush" Color="{StaticResource TealHoverColor}" />
    <SolidColorBrush x:Key="TealPressedBrush" Color="{StaticResource TealPressedColor}" />
    <SolidColorBrush x:Key="TealSoftBrush" Color="{StaticResource TealSoftColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnNavyBrush" Color="{StaticResource TextOnNavyColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />

    <!-- Semi-transparent white overlay (used over disabled grids / behind empty states) -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#FFFFFF" Opacity="0.67" />

    <!-- 20% black overlay for modal scrims (ErrorWindow icon background, etc.) -->
    <SolidColorBrush x:Key="OverlayDarkBrush" Color="#000000" Opacity="0.2" />

    <!-- Refined border radiuses for a sleeker, modern aesthetic -->
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>

</ResourceDictionary>
